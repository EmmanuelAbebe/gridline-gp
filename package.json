{
  "name": "gridline-gp",
  "productName": "Gridline GP",
  "version": "1.0.0",
  "description": "F1-style racing game, played with a phone tilt wheel.",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "node tools/dev-app.mjs",
    "build": "vite build && npm run phone:build",
    "start": "npm run build && electron .",
    "test": "node --test \"tests/**/*.test.js\" && node --experimental-strip-types --no-warnings --test \"phone-wheel/web/test/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc -p . && tsc -p phone-wheel/web",
    "check": "eslint . && npm run typecheck && npm test && npm run build",
    "phone:dev": "vite --config phone-wheel/web/vite.config.ts",
    "phone:build": "vite build --config phone-wheel/web/vite.config.ts",
    "phone:watch": "vite build --watch --config phone-wheel/web/vite.config.ts",
    "sim-test": "node tools/sim-test.mjs",
    "lap-optimum": "node tools/lap-optimum.mjs",
    "ghost-bench": "node tools/ghost-bench.mjs",
    "sim-trace": "node tools/sim-trace.mjs",
    "car-shot": "electron tools/car-shot.cjs",
    "sound-check": "electron tools/sound-check.cjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "^44.5.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  },
  "dependencies": {
    "@fontsource/saira": "5.3.0",
    "@fontsource/saira-condensed": "5.3.0",
    "node-forge": "1.4.0",
    "qrcode": "1.5.4",
    "three": "0.128.0",
    "ws": "8.22.0"
  },
  "type": "module"
}
